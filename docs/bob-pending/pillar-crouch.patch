@@ -982,6 +982,42 @@ public class BotStuntTests {
         });
     }
 
+    /**
+     * Two zombies at it on the edge of a drop (a pit six deep at its back), a pillar fight: not
+     * knocked off the pillar into the pit by their blows - crouched up there, the edge holds it
+     * (two self-play league deaths: a pillar on a slope, a blow, five blocks down to the zombies).
+     */
+    @GameTest(environment = "challengecraft:brawl", structure = STRUCTURE, maxTicks = 1300, skyAccess = true, padding = 24)
+    public void pillarByADrop(GameTestHelper h) {
+        BotArena a = BotArena.flat(h, "pillar_by_a_drop");
+        var level = h.getLevel();
+        level.getServer().getCommands().performPrefixedCommand(level.getServer().createCommandSourceStack().withSuppressedOutput(), "difficulty hard");
+        a.fill(21, BotArena.GROUND - 6, 14, 30, BotArena.GROUND, 26, Blocks.AIR);
+        java.util.List<net.minecraft.world.entity.monster.zombie.Zombie> zombies = new java.util.ArrayList<>();
+        for (int[] at : new int[][]{{18, 19}, {18, 21}}) {
+            var z = EntityTypes.ZOMBIE.create(level, net.minecraft.world.entity.EntitySpawnReason.MOB_SUMMONED);
+            z.setItemSlot(net.minecraft.world.entity.EquipmentSlot.HEAD, new ItemStack(Items.LEATHER_HELMET));
+            z.addEffect(new net.minecraft.world.effect.MobEffectInstance(net.minecraft.world.effect.MobEffects.FIRE_RESISTANCE, 20 * 600));
+            z.setPos(net.minecraft.world.phys.Vec3.atBottomCenterOf(a.abs(at[0], FEET, at[1])));
+            z.setPersistenceRequired();
+            level.addFreshEntity(z);
+            zombies.add(z);
+        }
+        a.spawn(20, FEET, 20, new ItemStack(Items.STONE_SWORD), new ItemStack(Items.COBBLESTONE, 32));
+        var body = a.bot().body();
+        double floor = a.abs(0, FEET, 0).getY() - 0.5;
+        boolean[] fell = {false};
+        a.run(new net.kasax.challengecraft.bot.task.PillarFightTask(zombies.get(0)).untilClear(), 1300, () -> {
+            for (var z : zombies) if (z.isAlive() && z.getTarget() != body) z.setTarget(body);
+            if (a.bot().body() != body || !body.isAlive()) h.fail("pillar_by_a_drop: killed");
+            fell[0] |= body.getY() < floor;
+            h.assertTrue(!fell[0], "pillar_by_a_drop: knocked off into the pit");
+            if (zombies.stream().anyMatch(net.minecraft.world.entity.LivingEntity::isAlive) && h.getTick() < 1200) return false;
+            BotArena.LOG.info("[BOTTEST] pillar_by_a_drop hp {} zombies left {}", body.getHealth(), zombies.stream().filter(net.minecraft.world.entity.LivingEntity::isAlive).count());
+            return true;
+        });
+    }
+
     private static void brawlFromPillar(GameTestHelper h, String name, net.minecraft.world.entity.EntityType<? extends net.minecraft.world.entity.Mob> type) {
         brawlFromPillar(h, name, type, a -> { });
     }
